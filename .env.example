DASHSCOPE_API_KEY=sk-replace-me
# qwen-audio-* / cosyvoice-* models use the SpeechSynthesizer API and support emotion tags,
# natural-language instructions, rate and pitch. qwen3-tts-* models use the older
# multimodal-generation API (text and voice only). The endpoint defaults to the one the
# model needs; only set DASHSCOPE_ENDPOINT to point at a proxy or mock.
QWEN_TTS_MODEL=qwen-audio-3.1-tts-flash
#DASHSCOPE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer
# Only used by qwen3-tts-* models.
QWEN_TTS_LANGUAGE_TYPE=Auto
# Optional qwen-audio language_hints entry (zh, en, ja, ...). English-only voices always use en.
#QWEN_TTS_LANGUAGE_HINT=zh
# Optional JSON object sent as qwen-audio hot_fix, e.g. {"replace":[{"HoP":"人事部长"}]}.
#QWEN_TTS_HOT_FIX_FILE=./hot_fix.json
# Optional JSON array of cloned/designed voices:
# [{"id":"Captain Man","voice":"<voice id from the cloning API>","label":"舰长","gender":"male"}]
#QWEN_TTS_CUSTOM_VOICES=./custom_voices.json
# Player-made voices (voice design and cloning, qwen-audio models only).
# The registry, previews and recordings awaiting review live here.
TTS_DATA_DIR=./data
TTS_CUSTOM_VOICE_LIMIT=3
TTS_CUSTOM_VOICE_DAILY_CREATIONS=10
DASHSCOPE_TIMEOUT_MS=5500
# qwen-audio-3.1-tts-flash allows 3 requests per second.
DASHSCOPE_MAX_CONCURRENCY=3

TTS_AUTHORIZATION_TOKEN=replace-with-openssl-rand-hex-32
TTS_BIND_ADDR=127.0.0.1:5002
TTS_CACHE_DIR=./cache
TTS_CACHE_MAX_BYTES=5368709120
TTS_CACHE_TTL_SECONDS=86400
TTS_MAX_TEXT_CHARS=1200

RUST_LOG=ss13_tts=info
